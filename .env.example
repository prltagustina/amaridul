# Copy to .env.local and fill with `npm run keys:generate`.
# Generate a DIFFERENT set of secrets for each environment (local, preview, production). Never reuse them.

# local | test | preview | production
APP_ENV=local

# Empty locally: PGlite stores the database in PGLITE_DIR. Production: the approved Postgres provider.
# DATABASE_URL=
PGLITE_DIR=.data/pglite

# Private file storage outside public/ (local only).
STORAGE_DIR=.data/storage

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Field encryption (AES-256-GCM) and DNI lookup (HMAC-SHA256). Two DIFFERENT keyrings.
# Format: v1:<base64 of 32 bytes>,v2:<…>. Rotation: add v2, set *_ACTIVE=v2, re-encrypt, then remove v1.
FIELD_KEYS=
FIELD_KEY_ACTIVE=v1
LOOKUP_KEYS=
LOOKUP_KEY_ACTIVE=v1

# Emails go to the console unless RESEND_API_KEY is set (production: Resend, domain amaridul.com verified).
EMAIL_FROM="Amarí Dul (local) <notificaciones@example.com>"
# RESEND_API_KEY=   # server-only secret, "Sending access" key restricted to the domain; never commit it
# EMAIL_REPLY_TO=
